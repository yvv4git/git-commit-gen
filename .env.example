# This file is read from the current working directory.
# Values here override config.toml.
# The API URL is set only in config.toml.

# Generator options
GIT_GEN_BASE_BRANCH=main

# Proxy options
GIT_GEN_PROXY_ENABLE=true
GIT_GEN_PROXY_TYPE=socks5
GIT_GEN_PROXY_ADDR=hostname:1080
GIT_GEN_PROXY_LOGIN=user
GIT_GEN_PROXY_PASSW=password

# LLM OpenAI options
GIT_GEN_OPENAI_TOKEN=sk-or-v1-1234567890
GIT_GEN_OPENAI_MODEL=inclusionai/ling-3.0-flash:free

# Retry options
GIT_GEN_LLM_RETRY_RETRIES=3
GIT_GEN_LLM_RETRY_INIT_INTERVAL=500ms
GIT_GEN_LLM_RETRY_MAX_INTERVAL=10s
